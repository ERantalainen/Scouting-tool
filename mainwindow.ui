  <property name="styleSheet">
   <string notr="true">QWidget {
    background-color: #1a1a1a;
    color: #FFFFFF;
}

/* Labels (text and images) */
QLabel {
    color: #FFFFFF;
    padding: 8px;                 /* padding around text or pixmap */
    qproperty-alignment: AlignCenter;
}

/* Optional alignment helpers: set widget-&gt;setProperty(&quot;align&quot;, &quot;...&quot;) */
QLabel[align=&quot;left&quot;]   { qproperty-alignment: AlignLeft; }
QLabel[align=&quot;center&quot;] { qproperty-alignment: AlignCenter; }
QLabel[align=&quot;right&quot;]  { qproperty-alignment: AlignRight; }

QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background-color: #1a1a1a;
    color: #FFFFFF;
    border: 1px solid #FFD400;    /* yellow accent */
    border-radius: 4px;
    padding: 6px 8px;
    selection-background-color: #FFD400;
    selection-color: #000000;
}

QLineEdit[align=&quot;left&quot;]   { qproperty-alignment: AlignLeft; }
QLineEdit[align=&quot;center&quot;] { qproperty-alignment: AlignCenter; }
QLineEdit[align=&quot;right&quot;]  { qproperty-alignment: AlignRight; }

/* Buttons */
QPushButton {
    background-color: #FFD400;    /* yellow */
    color: #000000;               /* black text */
    border: 1px solid #FFD400;
    border-radius: 4px;
    padding: 6px 12px;
    font-weight: 600;
}
QPushButton:hover  { background-color: #FFE34D; }
QPushButton:pressed{ background-color: #E6BF00; }
QPushButton:disabled {
    background-color: #2A2A2A;
    color: #777777;
    border-color: #2A2A2A;
}

/* Group boxes and frames */
QGroupBox {
    border: 1px solid #FFD400;
    border-radius: 6px;
    margin-top: 10px;
    padding: 8px;
    color: #FFFFFF;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 6px;
    color: #FFD400;
}

QFrame {
    border: 1px solid #444444;
    border-radius: 4px;
}

/* Lists and tables */
QListView, QTreeView, QTableView {
    background-color: #000000;
    color: #FFFFFF;
    alternate-background-color: #111111;
    selection-background-color: #FFD400;
    selection-color: #000000;
}
QHeaderView::section {
    background-color: #222222;
    color: #FFFFFF;
    border: 1px solid #444444;
    padding: 6px 8px;
}

/* Tooltips */
QToolTip {
    background-color: #FFD400;
    color: #000000;
    border: 1px solid #FFD400;
    padding: 6px 8px;
}

/* Checkboxes and radio buttons */
QCheckBox, QRadioButton {
    color: #FFFFFF;
    padding: 4px;
}
QCheckBox::indicator, QRadioButton::indicator {
    width: 14px;
    height: 14px;
}
QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background-color: #FFD400;
    border: 1px solid #FFD400;
}
QCheckBox::indicator:unchecked, QRadioButton::indicator:unchecked {
    background-color: #000000;
    border: 1px solid #FFFFFF;
}
</string>
