/* Simple Qt StyleSheet: Black/White/Yellow with image padding and text alignment */

QWidget {
    background-color: #000000;
    color: #FFFFFF;
}

/* Labels (text and images) */
QLabel {
    color: #FFFFFF;
    padding: 8px;                 /* padding around text or pixmap */
    qproperty-alignment: AlignCenter;
}

/* Optional alignment helpers: set widget->setProperty("align", "...") */
QLabel[align="left"]   { qproperty-alignment: AlignLeft; }
QLabel[align="center"] { qproperty-alignment: AlignCenter; }
QLabel[align="right"]  { qproperty-alignment: AlignRight; }

QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background-color: #1a1a1a;
    color: #FFFFFF;
    border: 1px solid #FFD400;    /* yellow accent */
    border-radius: 4px;
    padding: 32px 8px;
    selection-background-color: #FFD400;
    selection-color: #000000;
    qproperty-alignment: AlignCenter;
}

QLineEdit[align="left"]   { qproperty-alignment: AlignLeft; }
QLineEdit[align="center"] { qproperty-alignment: AlignCenter; }
QLineEdit[align="right"]  { qproperty-alignment: AlignRight; }

/* Buttons */
QPushButton {
    background-color: #FFD400;    /* yellow */
    color: #000000;               /* black text */
    border: 1px solid #FFD400;
    border-radius: 4px;
    padding: 6px 12px;
    font-weight: 600;
    qproperty-alignment: AlignCenter;
}
QPushButton:hover  { background-color: #FFE34D; }
QPushButton:pressed{ background-color: #E6BF00; }
QPushButton:disabled {
    background-color: #2A2A2A;
    color: #777777;
    border-color: #2A2A2A;
}

/* Group boxes and frames */
QGroupBox {
    border: 1px solid #FFD400;
    border-radius: 6px;
    margin-top: 10px;
    padding: 8px;
    color: #FFFFFF;
    qproperty-alignment: AlignCenter;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 6px;
    color: #FFD400;
}

QFrame {
    border: 1px solid #444444;
    border-radius: 4px;
}

/* Lists and tables */
QListView, QTreeView, QTableView {
    background-color: #1a1a1a;
    color: #FFFFFF;
    alternate-background-color: #111111;
    selection-background-color: #FFD400;
    selection-color: #000000;
}
QHeaderView::section {
    background-color: #222222;
    color: #FFFFFF;
    border: 1px solid #444444;
    padding: 6px 8px;
}

/* Tooltips */
QToolTip {
    background-color: #FFD400;
    color: #000000;
    border: 1px solid #FFD400;
    padding: 6px 8px;
    qproperty-alignment: AlignCenter;
}

/* Checkboxes and radio buttons */
QCheckBox, QRadioButton {
    color: #FFFFFF;
    padding: 4px;
    qproperty-alignment: AlignCenter;
}
QCheckBox::indicator, QRadioButton::indicator {
    width: 14px;
    height: 14px;
}
QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background-color: #FFD400;
    border: 1px solid #FFD400;
}
QCheckBox::indicator:unchecked, QRadioButton::indicator:unchecked {
    background-color: #1a1a1a;
    border: 1px solid #FFFFFF;
}
